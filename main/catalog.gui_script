-- Catalog bar across the top of the screen: tap a label to "arm" that
-- furniture item, then tap the floor to place it (handled by
-- placement_controller.script on the /controller game object).

local ITEM_IDS = { "cat_1", "cat_2", "cat_3", "cat_4", "cat_5", "cat_6", "cat_7", "cat_8" }

local NORMAL_COLOR = vmath.vector4(1, 1, 1, 1)
local SELECTED_COLOR = vmath.vector4(1, 0.85, 0.2, 1)

function init(self)
	msg.post(".", "acquire_input_focus")
	self.nodes = {}
	for i, node_id in ipairs(ITEM_IDS) do
		self.nodes[i] = gui.get_node(node_id)
	end
	self.selected = nil
end

local function select(self, index)
	if self.selected then
		gui.set_color(self.nodes[self.selected], NORMAL_COLOR)
	end
	self.selected = index
	gui.set_color(self.nodes[index], SELECTED_COLOR)
	msg.post("/controller#controller", "arm_item", { index = index })
end

function on_input(self, action_id, action)
	if action_id ~= hash("touch") or not action.pressed then
		return false
	end
	for i, node in ipairs(self.nodes) do
		if gui.pick_node(node, action.x, action.y) then
			select(self, i)
			return true
		end
	end
	return false
end
