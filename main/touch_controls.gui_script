-- Virtual joystick: touch/drag the circle bottom-left, it reports a
-- normalized (dx, dy) direction to the character via a "touch_move" message.
-- This feeds into character.script's movement alongside the keyboard, so
-- the same game works with mouse, keyboard, or a finger on Android.

local MAX_DIST = 60

function init(self)
	msg.post(".", "acquire_input_focus")
	self.bg = gui.get_node("joystick_bg")
	self.nub = gui.get_node("joystick_nub")
	self.center = gui.get_position(self.bg)
	self.dragging = false
	self.dx = 0
	self.dy = 0
end

local function send_move(self)
	msg.post("/character#character", "touch_move", { dx = self.dx, dy = self.dy })
end

function on_input(self, action_id, action)
	if action_id ~= hash("touch") then
		return false
	end

	if action.pressed then
		local p = vmath.vector3(action.x, action.y, 0)
		-- only start dragging if the touch began reasonably close to the stick
		if vmath.length(p - self.center) <= MAX_DIST * 2.5 then
			self.dragging = true
		end
	end

	if not self.dragging then
		return false
	end

	if action.released then
		self.dragging = false
		self.dx = 0
		self.dy = 0
		gui.set_position(self.nub, self.center)
		send_move(self)
		return true
	end

	local p = vmath.vector3(action.x, action.y, 0)
	local offset = p - self.center
	local dist = vmath.length(offset)
	if dist > MAX_DIST then
		offset = offset * (MAX_DIST / dist)
	end
	gui.set_position(self.nub, self.center + offset)
	self.dx = offset.x / MAX_DIST
	self.dy = offset.y / MAX_DIST
	send_move(self)
	return true
end
