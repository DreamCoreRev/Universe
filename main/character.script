local SPEED = 120

local STANDING = {
	n  = hash("north"),
	s  = hash("south"),
	e  = hash("east"),
	w  = hash("west"),
	ne = hash("northeast"),
	nw = hash("northwest"),
	se = hash("southeast"),
	sw = hash("southwest"),
}

local WALKING = {
	n  = hash("walk_n"),
	s  = hash("walk_s"),
	e  = hash("walk_e"),
	w  = hash("walk_w"),
	ne = hash("walk_ne"),
	nw = hash("walk_nw"),
	se = hash("walk_se"),
	sw = hash("walk_sw"),
}

-- sit poses made so far; falls back to the normal standing pose for any
-- direction without one yet
local SITTING = {
	s  = hash("sit_s"),
	sw = hash("sit_sw"),
}

-- while standing still (not walking, not seated) the body and head are
-- drawn as two separate layered sprites so each can be tinted its own
-- color (character customization panel). Only the 8 standing directions
-- have been split into layers so far -- walking and sitting still use the
-- single un-split image on #sprite (see update()), tinted with the body
-- color only, and #sprite_head is hidden during those poses.
local BODY_STANDING = {
	n  = hash("body_north"),
	s  = hash("body_south"),
	e  = hash("body_east"),
	w  = hash("body_west"),
	ne = hash("body_northeast"),
	nw = hash("body_northwest"),
	se = hash("body_southeast"),
	sw = hash("body_southwest"),
}
local HEAD_STANDING = {
	n  = hash("head_north"),
	s  = hash("head_south"),
	e  = hash("head_east"),
	w  = hash("head_west"),
	ne = hash("head_northeast"),
	nw = hash("head_northwest"),
	se = hash("head_southeast"),
	sw = hash("head_southwest"),
}

-- placed furniture (placement_controller.script) sits at z 0.15; while
-- seated the character needs a higher z so it draws in FRONT of the chair
-- instead of peeking out from behind it
local STAND_Z = 0.0
local SEATED_Z = 0.2

local DEFAULT_TINT = vmath.vector4(1, 1, 1, 1)

local function pick_direction(dx, dy)
	if dx > 0 and dy > 0 then return "ne" end
	if dx < 0 and dy > 0 then return "nw" end
	if dx > 0 and dy < 0 then return "se" end
	if dx < 0 and dy < 0 then return "sw" end
	if dx > 0 then return "e" end
	if dx < 0 then return "w" end
	if dy > 0 then return "n" end
	if dy < 0 then return "s" end
	return nil
end

function init(self)
	msg.post(".", "acquire_input_focus")
	self.input = { up = false, down = false, left = false, right = false }
	self.facing = "s"
	-- while standing still, #sprite shows the body-only layer and
	-- #sprite_head (on top) shows the head-only layer; while walking/
	-- seated, #sprite shows the old single-piece image instead and
	-- #sprite_head is disabled -- see update()
	self.current_body_anim = BODY_STANDING.s
	self.current_head_anim = HEAD_STANDING.s
	self.head_sprite_on = true
	sprite.play_flipbook("#sprite", self.current_body_anim)
	sprite.play_flipbook("#sprite_head", self.current_head_anim)
	-- customization colors (set via the "Personnaliser" panel); white = no
	-- tint, i.e. the mannequin's original grey
	self.head_color = DEFAULT_TINT
	self.body_color = DEFAULT_TINT
	go.set("#sprite", "tint", self.body_color)
	go.set("#sprite_head", "tint", self.head_color)
	-- accumulated push-back correction applied this frame by the physics
	-- engine when the kinematic collision shape overlaps a static one
	-- (floor/wall/furniture). Reset every frame in update().
	self.correction = vmath.vector3()
	-- direction reported by the on-screen virtual joystick (touch_controls.gui),
	-- each in the range -1..1. Zero when nothing is being dragged.
	self.touch_dx = 0
	self.touch_dy = 0
	-- true while the chat input (chat.gui_script) is open, so WASD/arrow
	-- keys type into the chat box instead of moving the character
	self.chat_active = false
	-- true while sitting on a chair (placement_controller.script sends
	-- "sit_at" on a tap, see find_at/on_input there)
	self.seated = false
end

function final(self)
	msg.post(".", "release_input_focus")
end

function on_input(self, action_id, action)
	if self.chat_active then
		return false
	end
	if self.seated and action.pressed and (action_id == hash("up") or action_id == hash("down")
		or action_id == hash("left") or action_id == hash("right")) then
		-- any movement key stands the character back up; let it fall
		-- through so this same key press also starts moving right away
		self.seated = false
		local pos = go.get_position()
		pos.z = STAND_Z
		go.set_position(pos)
	end
	if action_id == hash("up") then
		if action.pressed then self.input.up = true end
		if action.released then self.input.up = false end
	elseif action_id == hash("down") then
		if action.pressed then self.input.down = true end
		if action.released then self.input.down = false end
	elseif action_id == hash("left") then
		if action.pressed then self.input.left = true end
		if action.released then self.input.left = false end
	elseif action_id == hash("right") then
		if action.pressed then self.input.right = true end
		if action.released then self.input.right = false end
	end
end

function on_message(self, message_id, message, sender)
	if message_id == hash("contact_point_response") then
		-- Standard Defold kinematic-vs-static collision resolution: for every
		-- contact point reported this frame, push the character back out of
		-- the obstacle along the contact normal, without double-correcting
		-- for contacts already resolved this frame.
		if not self.seated and message.distance > 0 then
			local proj = vmath.project(self.correction, message.normal * message.distance)
			local comp = (message.distance - proj) * message.normal
			go.set_position(go.get_position() + comp)
			self.correction = self.correction + comp
		end
	elseif message_id == hash("touch_move") then
		-- sent every frame the virtual joystick (touch_controls.gui_script)
		-- is being dragged; (0, 0) when released
		self.touch_dx = message.dx
		self.touch_dy = message.dy
	elseif message_id == hash("sit_at") then
		self.seated = true
		self.touch_dx, self.touch_dy = 0, 0
		self.input = { up = false, down = false, left = false, right = false }
		self.facing = "sw"
		go.set_position(vmath.vector3(message.x, message.y, SEATED_Z))
	elseif message_id == hash("chat_active") then
		-- sent by chat.gui_script when the chat input opens/closes
		self.chat_active = message.active
		if self.chat_active then
			self.input = { up = false, down = false, left = false, right = false }
			self.touch_dx = 0
			self.touch_dy = 0
		end
	elseif message_id == hash("set_head_color") then
		-- sent by customize.gui_script when a head swatch is tapped
		self.head_color = message.color
		go.set("#sprite_head", "tint", self.head_color)
	elseif message_id == hash("set_body_color") then
		-- sent by customize.gui_script when a clothes swatch is tapped;
		-- applies to #sprite whether it's currently showing the body-only
		-- layer (standing) or the old single-piece image (walking/seated)
		self.body_color = message.color
		go.set("#sprite", "tint", self.body_color)
	end
end

function update(self, dt)
	-- clear the correction accumulator at the start of each frame; it is
	-- filled in by on_message as the physics engine reports contacts
	self.correction = vmath.vector3()

	local dx = (self.input.right and 1 or 0) - (self.input.left and 1 or 0) + self.touch_dx
	local dy = (self.input.up and 1 or 0) - (self.input.down and 1 or 0) + self.touch_dy
	if self.chat_active or self.seated then
		dx, dy = 0, 0
	end
	local moving = (dx ~= 0 or dy ~= 0)

	if moving then
		local len = math.sqrt(dx * dx + dy * dy)
		local pos = go.get_position()
		pos.x = pos.x + (dx / len) * SPEED * dt
		pos.y = pos.y + (dy / len) * SPEED * dt
		go.set_position(pos)
		self.facing = pick_direction(dx, dy)
	end

	local standing_still = not moving and not self.seated

	if standing_still then
		-- two-layer pose: body tint + head tint, drawn as separate sprites
		if not self.head_sprite_on then
			msg.post("#sprite_head", "enable")
			self.head_sprite_on = true
		end
		local body_target = BODY_STANDING[self.facing]
		if body_target ~= self.current_body_anim then
			sprite.play_flipbook("#sprite", body_target)
			self.current_body_anim = body_target
		end
		local head_target = HEAD_STANDING[self.facing]
		if head_target ~= self.current_head_anim then
			sprite.play_flipbook("#sprite_head", head_target)
			self.current_head_anim = head_target
		end
	else
		-- single-piece pose (walking or seated): no matching layered
		-- asset yet, so hide the separate head layer and show the old
		-- full-figure image, tinted with the body/clothes color as an
		-- approximation until walking/sitting get their own layers too
		if self.head_sprite_on then
			msg.post("#sprite_head", "disable")
			self.head_sprite_on = false
		end
		local target
		if moving then
			target = WALKING[self.facing]
		else
			target = SITTING[self.facing] or STANDING[self.facing]
		end
		if target ~= self.current_body_anim then
			sprite.play_flipbook("#sprite", target)
			self.current_body_anim = target
		end
	end

	-- gui_script files can't call go.* functions directly, so the chat
	-- speech bubble (chat.gui_script) needs this posted to it each frame
	-- to know where the character is on screen
	msg.post("/chat#chat", "character_moved", { pos = go.get_position() })
end
