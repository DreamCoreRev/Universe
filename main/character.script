local SPEED = 120

local STANDING = {
	n  = hash("north"),
	s  = hash("south"),
	e  = hash("east"),
	w  = hash("west"),
	ne = hash("northeast"),
	nw = hash("northwest"),
	se = hash("southeast"),
	sw = hash("southwest"),
}

local WALKING = {
	n  = hash("walk_n"),
	s  = hash("walk_s"),
	e  = hash("walk_e"),
	w  = hash("walk_w"),
	ne = hash("walk_ne"),
	nw = hash("walk_nw"),
	se = hash("walk_se"),
	sw = hash("walk_sw"),
}

local function pick_direction(dx, dy)
	if dx > 0 and dy > 0 then return "ne" end
	if dx < 0 and dy > 0 then return "nw" end
	if dx > 0 and dy < 0 then return "se" end
	if dx < 0 and dy < 0 then return "sw" end
	if dx > 0 then return "e" end
	if dx < 0 then return "w" end
	if dy > 0 then return "n" end
	if dy < 0 then return "s" end
	return nil
end

function init(self)
	msg.post(".", "acquire_input_focus")
	self.input = { up = false, down = false, left = false, right = false }
	self.facing = "s"
	self.current_anim = STANDING.s
	sprite.play_flipbook("#sprite", self.current_anim)
	-- accumulated push-back correction applied this frame by the physics
	-- engine when the kinematic collision shape overlaps a static one
	-- (floor/wall/furniture). Reset every frame in update().
	self.correction = vmath.vector3()
	-- direction reported by the on-screen virtual joystick (touch_controls.gui),
	-- each in the range -1..1. Zero when nothing is being dragged.
	self.touch_dx = 0
	self.touch_dy = 0
	-- true while the chat input (chat.gui_script) is open, so WASD/arrow
	-- keys type into the chat box instead of moving the character
	self.chat_active = false
	-- true while sitting on a chair (placement_controller.script sends
	-- "sit_at" on a tap, see find_at/on_input there)
	self.seated = false
end

function final(self)
	msg.post(".", "release_input_focus")
end

function on_input(self, action_id, action)
	if self.chat_active then
		return false
	end
	if self.seated and action.pressed and (action_id == hash("up") or action_id == hash("down")
		or action_id == hash("left") or action_id == hash("right")) then
		-- any movement key stands the character back up; let it fall
		-- through so this same key press also starts moving right away
		self.seated = false
	end
	if action_id == hash("up") then
		if action.pressed then self.input.up = true end
		if action.released then self.input.up = false end
	elseif action_id == hash("down") then
		if action.pressed then self.input.down = true end
		if action.released then self.input.down = false end
	elseif action_id == hash("left") then
		if action.pressed then self.input.left = true end
		if action.released then self.input.left = false end
	elseif action_id == hash("right") then
		if action.pressed then self.input.right = true end
		if action.released then self.input.right = false end
	end
end

function on_message(self, message_id, message, sender)
	if message_id == hash("contact_point_response") then
		-- Standard Defold kinematic-vs-static collision resolution: for every
		-- contact point reported this frame, push the character back out of
		-- the obstacle along the contact normal, without double-correcting
		-- for contacts already resolved this frame.
		if not self.seated and message.distance > 0 then
			local proj = vmath.project(self.correction, message.normal * message.distance)
			local comp = (message.distance - proj) * message.normal
			go.set_position(go.get_position() + comp)
			self.correction = self.correction + comp
		end
	elseif message_id == hash("touch_move") then
		-- sent every frame the virtual joystick (touch_controls.gui_script)
		-- is being dragged; (0, 0) when released
		self.touch_dx = message.dx
		self.touch_dy = message.dy
	elseif message_id == hash("sit_at") then
		self.seated = true
		self.touch_dx, self.touch_dy = 0, 0
		self.input = { up = false, down = false, left = false, right = false }
		self.facing = "s"
		go.set_position(vmath.vector3(message.x, message.y + 10, go.get_position().z))
	elseif message_id == hash("chat_active") then
		-- sent by chat.gui_script when the chat input opens/closes
		self.chat_active = message.active
		if self.chat_active then
			self.input = { up = false, down = false, left = false, right = false }
			self.touch_dx = 0
			self.touch_dy = 0
		end
	end
end

function update(self, dt)
	-- clear the correction accumulator at the start of each frame; it is
	-- filled in by on_message as the physics engine reports contacts
	self.correction = vmath.vector3()

	local dx = (self.input.right and 1 or 0) - (self.input.left and 1 or 0) + self.touch_dx
	local dy = (self.input.up and 1 or 0) - (self.input.down and 1 or 0) + self.touch_dy
	if self.chat_active or self.seated then
		dx, dy = 0, 0
	end
	local moving = (dx ~= 0 or dy ~= 0)

	if moving then
		local len = math.sqrt(dx * dx + dy * dy)
		local pos = go.get_position()
		pos.x = pos.x + (dx / len) * SPEED * dt
		pos.y = pos.y + (dy / len) * SPEED * dt
		go.set_position(pos)
		self.facing = pick_direction(dx, dy)
	end

	local target = moving and WALKING[self.facing] or STANDING[self.facing]
	if target ~= self.current_anim then
		sprite.play_flipbook("#sprite", target)
		self.current_anim = target
	end

	-- gui_script files can't call go.* functions directly, so the chat
	-- speech bubble (chat.gui_script) needs this posted to it each frame
	-- to know where the character is on screen
	msg.post("/chat#chat", "character_moved", { pos = go.get_position() })
end
