-- Spawns furniture from the catalog, keeps track of what's been placed
-- (the "placed" list is also what the upcoming save/load step will write
-- to disk), and lets the player pick an already-placed item back up and
-- drag it to a new spot.
--
-- Tap priority: tapping ON an existing piece of furniture and holding
-- while moving the cursor drags it to a new spot. A plain tap (press and
-- release without much movement) instead triggers an interaction: sitting
-- down if it's a chair, or -- while "Supprimer un mobi" is armed from the
-- catalog -- removing it from the room. Tapping empty floor while an item
-- is armed places a new copy there. Tapping and holding empty floor with
-- nothing armed instead pans the camera around the room (see
-- camera.script); releasing snaps the view back to the room's center.

local ITEMS = {
	{ id = "chair",    anim = "chair_SW" },
	{ id = "table",    anim = "table_SW" },
	{ id = "sofa",     anim = "loungeSofa_SW" },
	{ id = "bed",      anim = "bedSingle_SW" },
	{ id = "lamp",     anim = "lampRoundFloor_SW" },
	{ id = "plant",    anim = "pottedPlant_SW" },
	{ id = "tv",       anim = "televisionModern_SW" },
	{ id = "bookcase", anim = "bookcaseOpen_SW" },
}

local PICK_RADIUS = 50
local TAP_THRESHOLD = 8   -- max drag distance (px) still counted as a tap

-- the "Catalogue" (furniture), "Appartements" (room) and "Perso"
-- (character customization) toggle buttons are all stacked in the
-- bottom-right corner; ignore taps there even if a stray touch event
-- reaches us before/without the GUI consuming it
local UI_ZONE_X = 800.0
local UI_ZONE_Y = 190.0

function init(self)
	msg.post(".", "acquire_input_focus")
	self.armed = nil        -- index into ITEMS, "delete", or nil
	self.placed = {}        -- { {id=, anim=, url=, x=, y=}, ... }
	self.dragging = nil     -- index into self.placed currently being dragged
	self.drag_moved = false -- did the current drag move past the tap threshold
	self.press_x = 0
	self.press_y = 0
	self.catalog_open = false
	self.apt_open = false
	self.customize_open = false
	self.panning = false    -- true while dragging the camera around the room
end

function on_message(self, message_id, message, sender)
	if message_id == hash("arm_item") then
		self.armed = message.index
	elseif message_id == hash("arm_delete_mode") then
		self.armed = "delete"
	elseif message_id == hash("catalog_open") then
		self.catalog_open = message.open
	elseif message_id == hash("apt_open") then
		self.apt_open = message.open
	elseif message_id == hash("customize_open") then
		self.customize_open = message.open
	elseif message_id == hash("clear_furniture") then
		for _, p in ipairs(self.placed) do
			go.delete(p.url)
		end
		self.placed = {}
		self.dragging = nil
		self.armed = nil
	end
end

local function find_at(self, x, y)
	local best, best_dist = nil, PICK_RADIUS
	for i, p in ipairs(self.placed) do
		local d = vmath.length(vmath.vector3(p.x - x, p.y - y, 0))
		if d <= best_dist then
			best, best_dist = i, d
		end
	end
	return best
end

local function remove_placed(self, index)
	local p = self.placed[index]
	go.delete(p.url)
	table.remove(self.placed, index)
end

function on_input(self, action_id, action)
	if action_id ~= hash("touch") then
		return false
	end

	if (self.catalog_open or self.apt_open or self.customize_open) and not self.dragging then
		return false
	end

	if action.x >= UI_ZONE_X and action.y <= UI_ZONE_Y and not self.dragging then
		return false
	end

	if action.pressed then
		self.press_x, self.press_y = action.x, action.y
		local hit = find_at(self, action.x, action.y)
		if hit then
			self.dragging = hit
			self.drag_moved = false
			return true
		elseif self.armed == "delete" then
			-- tapped empty floor while in delete mode: just cancel it
			self.armed = nil
			return true
		elseif self.armed then
			local item = ITEMS[self.armed]
			local pos = vmath.vector3(action.x, action.y, 0.15)
			local url = factory.create("#factory", pos)
			msg.post(url, "set_item", { item_id = item.id, anim = item.anim })
			table.insert(self.placed, { id = item.id, anim = item.anim, url = url, x = action.x, y = action.y })
			return true
		else
			self.panning = true
			msg.post("/camera#camera_script", "pan_start", { x = action.x, y = action.y })
			return true
		end
	end

	if self.dragging then
		local dx = action.x - self.press_x
		local dy = action.y - self.press_y
		if not self.drag_moved and math.sqrt(dx * dx + dy * dy) > TAP_THRESHOLD then
			self.drag_moved = true
		end

		local p = self.placed[self.dragging]
		if self.drag_moved then
			p.x, p.y = action.x, action.y
			go.set_position(vmath.vector3(action.x, action.y, 0.15), p.url)
		end

		if action.released then
			if self.armed == "delete" then
				remove_placed(self, self.dragging)
			elseif not self.drag_moved and p.id == "chair" then
				msg.post("/character", "sit_at", { x = p.x, y = p.y })
			end
			self.dragging = nil
			self.drag_moved = false
		end
		return true
	end

	if self.panning then
		msg.post("/camera#camera_script", "pan_move", { x = action.x, y = action.y })
		if action.released then
			self.panning = false
			msg.post("/camera#camera_script", "pan_end")
		end
		return true
	end

	return false
end
